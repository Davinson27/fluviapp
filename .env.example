# ============================================================
# FluviApp v2.0 - Variables de Entorno y Configuración
# ============================================================

# Entorno de la Aplicación (local | production)
APP_ENV=local
APP_DEBUG=true

# Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fluviapp
DB_USER=root
DB_PASS=

# ============================================================
# Pasarela de Pagos Wompi Colombia
# ============================================================
# Modo de operación: 'sandbox' (pruebas) o 'production' (pagos reales)
WOMPI_MODE=sandbox

# Llaves de Wompi (Obtenidas en https://comercios.wompi.co/ -> Desarrolladores)
# Para pagos reales en producción:
# 1. Cambie WOMPI_MODE=production
# 2. Ingrese sus credenciales de la pestaña 'Producción' de Wompi
WOMPI_PUBLIC_KEY=pub_test_Q5yDA9xoKdePzhSGeVe9KStXTIHsIOuh
WOMPI_PRIVATE_KEY=prv_test_5n04Xj1M1t5fR6h9q2w4e6r8t0y2u4i6
WOMPI_INTEGRITY_SECRET=test_integrity_Q5yDA9xoKdePzhSGeVe9KStXTIHsIOuh
WOMPI_EVENTS_SECRET=test_events_Q5yDA9xoKdePzhSGeVe9KStXTIHsIOuh

